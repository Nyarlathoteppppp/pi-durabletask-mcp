{
  "name": "pi-durabletask-mcp",
  "version": "0.6.0",
  "mcpName": "io.github.Nyarlathoteppppp/pi-durabletask-mcp",
  "description": "Durable Pi Coding Agent tasks over MCP with background execution, steering, and crash recovery",
  "type": "module",
  "bin": {
    "pi-durabletask-mcp": "dist/index.js",
    "pi-delegate-mcp": "dist/index.js",
    "pi-delegate-statusline": "dist/statusline/cli.js"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./worker": "./dist/pi/worker.js",
    "./statusline": "./dist/statusline/state.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "README.zh-CN.md",
    "docs",
    "skills",
    "server.json",
    "scripts/link-pi-sdk.mjs",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "postinstall": "node scripts/link-pi-sdk.mjs",
    "sdk:link": "node scripts/link-pi-sdk.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test:ci": "npm test",
    "test": "npm run typecheck && npm run build && node test/offline.mjs",
    "test:live": "npm run build && node test/live.mjs",
    "bench:checkpoint": "npm run build && node scripts/benchmark-checkpoint.mjs",
    "prepublishOnly": "npm run test:ci"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "author": "Nyarlathoteppppp",
  "license": "MIT",
  "homepage": "https://github.com/Nyarlathoteppppp/pi-durabletask-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nyarlathoteppppp/pi-durabletask-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Nyarlathoteppppp/pi-durabletask-mcp/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "pi",
    "pi-coding-agent",
    "coding-agent",
    "subagent",
    "delegate",
    "claude-code",
    "llm",
    "openrouter",
    "deepseek",
    "grok",
    "codex"
  ],
  "dependencies": {
    "@earendil-works/chord": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-durable": "1.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "types": "dist/index.d.ts",
  "devDependencies": {
    "@types/node": "^26.3.0",
    "typescript": "^7.0.2"
  },
  "contributors": [
    "howznguyen <howznguyen@knowns.dev>"
  ]
}
